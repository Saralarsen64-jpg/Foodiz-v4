{
  "expo": {
    "name": "Weello",
    "slug": "foodiz",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/weello-app-icon-v2.png",
    "scheme": "weello",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/weello-app-icon-v2.png",
      "bundleIdentifier": "app.weello",
      "associatedDomains": [
        "applinks:weello.app"
      ],
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Weello utilise votre position pour enregistrer votre adresse, calculer la livraison et suivre une course en cours.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Pour les livreurs uniquement, Weello partage la position pendant une course active afin que le client puisse suivre sa livraison, même lorsque l’application est en arrière-plan."
      }
    },
    "android": {
      "package": "app.weello",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/images/weello-app-icon-v2.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "weello.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/weello-app-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/weello-wordmark.png",
          "imageWidth": 180,
          "android": {
            "image": "./assets/images/weello-wordmark.png",
            "imageWidth": 180
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Autoriser Weello à sécuriser votre session."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Weello à sélectionner vos justificatifs professionnels.",
          "cameraPermission": "Autoriser Weello à photographier vos justificatifs professionnels.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Weello utilise votre position pour enregistrer votre adresse, calculer la livraison et suivre une course en cours.",
          "locationAlwaysAndWhenInUsePermission": "Pour les livreurs uniquement, Weello partage la position pendant une course active afin que le client puisse suivre sa livraison, même lorsque l’application est en arrière-plan.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.app.weello",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50980db7-4f5d-4d22-8404-57e6e30b6cf2"
      }
    },
    "owner": "foodiz.co"
  }
}
