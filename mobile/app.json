{
  "expo": {
    "name": "Foodiz",
    "slug": "foodiz",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/foodiz-app-icon.png",
    "scheme": "foodiz",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.foodiz.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Foodiz utilise votre position pour enregistrer votre adresse et calculer les frais de livraison."
      }
    },
    "android": {
      "package": "com.foodiz.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/images/foodiz-app-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/foodiz-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/foodiz-app-icon.png",
          "imageWidth": 180,
          "android": {
            "image": "./assets/images/foodiz-app-icon.png",
            "imageWidth": 180
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Autoriser Foodiz à sécuriser votre session."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.foodiz.app",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50980db7-4f5d-4d22-8404-57e6e30b6cf2"
      }
    },
    "owner": "foodiz.co"
  }
}
