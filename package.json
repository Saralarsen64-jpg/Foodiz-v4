{
  "name": "weello-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "test:security": "node --test tests/security/*.test.ts",
    "test:economics": "node --test tests/economics/*.test.ts",
    "test:routing": "node --test tests/routing/*.test.ts",
    "test:routing:live": "node scripts/test-routing-live.ts",
    "test": "npm run test:security && npm run test:economics && npm run test:routing",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "check": "npm run typecheck && npm run build",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@netlify/functions": "^2.4.1",
    "@stripe/stripe-js": "^9.6.0",
    "@supabase/supabase-js": "^2.106.0",
    "@types/leaflet": "^1.9.21",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.15.1",
    "resend": "^6.12.4",
    "stripe": "^14.4.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "supabase": "^2.106.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vercel": "^54.14.0",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
