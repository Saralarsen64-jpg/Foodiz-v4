# ============================================================
# WEELLO CONFIGURATION
# ============================================================

# === SUPABASE ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === STRIPE ===
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === STRIPE PRICING PLANS ===
# Create these in your Stripe Dashboard and update the IDs
STRIPE_PLAN_DISCOVERY_MONTHLY=price_weello_discovery_monthly
STRIPE_PLAN_DISCOVERY_YEARLY=price_weello_discovery_yearly
STRIPE_PLAN_BOOST_MONTHLY=price_weello_boost_monthly
STRIPE_PLAN_BOOST_YEARLY=price_weello_boost_yearly
STRIPE_PLAN_DOMINATION_MONTHLY=price_weello_domination_monthly
STRIPE_PLAN_DOMINATION_YEARLY=price_weello_domination_yearly

# === DELIVERY & MAPS ===
VITE_MAPBOX_TOKEN=your_mapbox_token_optional
# Routing is server-side only. Never prefix these variables with VITE_ or
# EXPO_PUBLIC_, otherwise the key would be bundled into a client application.
ROUTING_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
# Reserved for the later migration to a private, self-hosted OSRM instance.
OSRM_BASE_URL=

# === APPLICATION ===
APP_URL=https://weello.app
WEELLO_ALLOWED_ORIGINS=https://weello.app,https://www.weello.app
VITE_APP_NAME=Weello
VITE_APP_VERSION=1.0.0

# === ADVANTAGE ROTATION ===
CRON_SECRET=

# === TRANSACTIONAL EMAILS & LEGAL DOCUMENTS ===
RESEND_API_KEY=
WEELLO_EMAIL_FROM=Weello <contact@weello.co>
EMAIL_FROM=Weello <contact@weello.co>
WEELLO_LEGAL_NAME=
WEELLO_LEGAL_ADDRESS=
WEELLO_SIRET=
# Leave empty while Weello is not liable for VAT.
WEELLO_VAT_NUMBER=

# Legacy compatibility: keep these only while an environment still uses them.
FOODIZ_EMAIL_FROM=
FOODIZ_LEGAL_NAME=
FOODIZ_LEGAL_ADDRESS=
FOODIZ_SIRET=
FOODIZ_VAT_NUMBER=

# ============================================================
# NOTES:
# ============================================================
# 1. Copy this file to .env.local for local development
# 2. In production, add these to your Vercel environment variables
# 3. Stripe keys should be for LIVE mode in production, TEST mode in development
# 4. The webhook secret is displayed once when creating the endpoint at:
#    https://dashboard.stripe.com/webhooks
# 5. Verify weello.co in Resend before using contact@weello.co as sender
# 6. Webhook endpoint URL in production is: https://weello.app/api/stripe-webhook
