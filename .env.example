# ============================================================
# FOODIZ CONFIGURATION
# ============================================================

# === SUPABASE ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# === STRIPE ===
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# === STRIPE PRICING PLANS ===
# Create these in your Stripe Dashboard and update the IDs
STRIPE_PLAN_BASIC_MONTHLY=price_1234567890abcdefghijklmn
STRIPE_PLAN_BASIC_YEARLY=price_abcdefghijklmnop1234567890
STRIPE_PLAN_PRO_MONTHLY=price_pro_monthly_your_id
STRIPE_PLAN_PRO_YEARLY=price_pro_yearly_your_id

# === DELIVERY & MAPS ===
VITE_MAPBOX_TOKEN=your_mapbox_token_optional

# === APPLICATION ===
VITE_APP_NAME=Foodiz
VITE_APP_VERSION=1.0.0

# ============================================================
# NOTES:
# ============================================================
# 1. Copy this file to .env.local for local development
# 2. In production, add these to your Netlify environment variables
# 3. Stripe keys should be for LIVE mode in production, TEST mode in development
# 4. The webhook secret is displayed once when creating the endpoint at:
#    https://dashboard.stripe.com/webhooks
# 5. Webhook endpoint URL should be:
#    https://your-domain.netlify.app/.netlify/functions/stripe-webhook
