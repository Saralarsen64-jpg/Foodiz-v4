# ============================================================
# FOODIZ CONFIGURATION
# ============================================================

# === SUPABASE ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# === STRIPE ===
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# === STRIPE PRICING PLANS ===
# Create these in your Stripe Dashboard and update the IDs
STRIPE_PLAN_DISCOVERY_MONTHLY=price_foodiz_discovery_monthly
STRIPE_PLAN_DISCOVERY_YEARLY=price_foodiz_discovery_yearly
STRIPE_PLAN_BOOST_MONTHLY=price_foodiz_boost_monthly
STRIPE_PLAN_BOOST_YEARLY=price_foodiz_boost_yearly
STRIPE_PLAN_DOMINATION_MONTHLY=price_foodiz_domination_monthly
STRIPE_PLAN_DOMINATION_YEARLY=price_foodiz_domination_yearly

# === DELIVERY & MAPS ===
VITE_MAPBOX_TOKEN=your_mapbox_token_optional

# === APPLICATION ===
APP_URL=https://foodiz.co
VITE_APP_NAME=Foodiz
VITE_APP_VERSION=1.0.0

# === ADVANTAGE ROTATION ===
CRON_SECRET=generate_a_long_random_secret

# ============================================================
# NOTES:
# ============================================================
# 1. Copy this file to .env.local for local development
# 2. In production, add these to your Vercel environment variables
# 3. Stripe keys should be for LIVE mode in production, TEST mode in development
# 4. The webhook secret is displayed once when creating the endpoint at:
#    https://dashboard.stripe.com/webhooks
# 5. Webhook endpoint URL should be:
#    https://your-domain.netlify.app/.netlify/functions/stripe-webhook
